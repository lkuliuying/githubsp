{
  "name": "dsh-githubsp",
  "version": "0.7.1",
  "type": "module",
  "description": "DeepSeek Harness 原生 GitHubSP 下载与本地关注工具",
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": "0.2.2-rc.1"
  },
  "main": "harness.mjs",
  "files": [
    "harness.mjs",
    "software-tools.mjs",
    "pnpm-lock.yaml",
    "skills",
    ".claude-plugin",
    ".mcp.json",
    "update-tools.mjs",
    "client.mjs",
    "tools.mjs",
    "mcp.mjs",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "harness-client.js",
    "locale"
  ],
  "bin": {
    "githubsp-mcp": "./mcp.mjs"
  },
  "exports": {
    ".": "./harness.mjs",
    "./client": "./harness-client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./icon": "./.claude-plugin/512x512.png",
    "./package.json": "./package.json",
    "./locale/*": "./locale/*"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-primitives"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.5",
    "@modelcontextprotocol/sdk": "1.32.2"
  },
  "homepage": "https://github.com/lkuliuying/githubsp",
  "repository": {
    "type": "git",
    "url": "https://github.com/lkuliuying/githubsp.git",
    "directory": "integrations/agent-tools"
  },
  "icon": "./.claude-plugin/512x512.png"
}
