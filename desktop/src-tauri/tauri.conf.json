{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GitHubSP",
  "version": "0.4.0",
  "identifier": "com.githubsp.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "GitHubSP",
        "width": 1280,
        "height": 820,
        "minWidth": 760,
        "minHeight": 560,
        "visible": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "copyright": "Copyright GitHubSP contributors",
    "resources": {
      "../../artifacts/build/tauri-notices/FRONTEND-LICENSES.txt": "licenses/FRONTEND-LICENSES.txt",
      "../../artifacts/build/tauri-notices/RUST-LICENSES.txt": "licenses/RUST-LICENSES.txt"
    },
    "shortDescription": "GitHub Release 下载工作台",
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": false },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": ["SimpChinese"],
        "startMenuFolder": "GitHubSP"
      }
    }
  }
}
