import { ComboBox, ListView, Switch } from "std-widgets.slint";
import { Theme, Panel, Heading, Input, ActionButton, Label, Muted, Stat, Badge, EmptyState, Message, Icon } from "theme.slint";
import { Favorites, FavoriteRow, Workspace } from "state.slint";
import { BentoGrid, BentoCard, MotionReveal } from "bento.slint";

component FavoriteCard inherits BentoCard {
    in property <FavoriteRow> item;
    private property <bool> show-actions;
    min-height: content.preferred-height;
    vertical-stretch: 0;
    content := VerticalLayout {
        padding: 16px; spacing: 10px;
        HorizontalLayout {
            spacing: 8px;
            Icon { source: @image-url("../resources/icons/Cube-regular.svg"); tint: Theme.muted; width: 22px; preferred-height: 22px; }
            Label { text: root.item.repository; font-size: 14px; font-weight: 600; }
            ActionButton { icon: @image-url("../resources/icons/DotsThreeVertical-regular.svg"); help: "更多收藏操作 · " + root.item.repository; compact: true; flat: true; clicked => { root.show-actions = !root.show-actions; } }
        }
        HorizontalLayout {
            spacing: 8px;
            Label { text: root.item.tag; font-size: 18px; font-weight: 600; }
            if root.item.unread: Badge { text: "有更新"; tone: 1; }
            Badge { text: root.item.state; tone: root.item.tone; }
        }
        if root.item.published != "": Muted { text: "发布于 " + root.item.published; font-size: 11px; }
        if root.item.summary != "": Text { text: root.item.summary; font-size: 12px; color: Theme.muted; wrap: word-wrap; overflow: elide; max-height: 36px; }
        Muted { text: "上次检查：" + root.item.checked; font-size: 11px; }
        if root.item.error != "": Message { text: root.item.error; error: root.item.tone == 2; }
        HorizontalLayout {
            spacing: 6px;
            ActionButton { text: "查看附件"; compact: true; enabled: !Favorites.busy; clicked => { Favorites.action(root.item.repository, "browse"); } }
            ActionButton { text: "下载最新版"; compact: true; primary: true; enabled: !Favorites.busy && root.item.downloadable; clicked => { Favorites.download(root.item.repository); } }
            ActionButton { text: "检查"; compact: true; flat: true; enabled: !Favorites.busy; clicked => { Favorites.action(root.item.repository, "check"); } }
        }
        if root.show-actions: HorizontalLayout {
            spacing: 6px;
            if root.item.unread: ActionButton { text: "标为已读"; compact: true; flat: true; enabled: !Favorites.busy; clicked => { Favorites.action(root.item.repository, "dismiss"); } }
            ActionButton { text: "关注规则"; compact: true; flat: true; enabled: !Favorites.busy; clicked => { Favorites.edit-rule(root.item.repository); } }
            ActionButton { icon: @image-url("../resources/icons/Link-regular.svg"); help: "复制仓库链接"; compact: true; flat: true; clicked => { Favorites.action(root.item.repository, "copy"); } }
            Rectangle { horizontal-stretch: 1; }
            ActionButton { icon: @image-url("../resources/icons/Trash-regular.svg"); help: "移除收藏，不影响下载文件"; danger: true; compact: true; enabled: !Favorites.busy; clicked => { Favorites.action(root.item.repository, "remove"); } }
        }
    }
}

export component FavoritesPage inherits VerticalLayout {
    in property <bool> entered: true;
    private property <int> row-count: Favorites.rows.length;
    private property <int> filter: Favorites.filter;
    private property <int> sort: Favorites.sort;
    private property <bool> list-mode: Favorites.list;
    changed row-count => { favorite-grid.reset(); }
    changed filter => { favorite-grid.reset(); }
    changed sort => { favorite-grid.reset(); }
    changed list-mode => { favorite-grid.reset(); }
    min-width: 0px;
    spacing: 16px;
    Panel {
        border-width: 0px;
        VerticalLayout {
            padding: 0px; spacing: 14px;
            title-reveal := MotionReveal {
                height: root.width < 700px ? 32px : 55px;
                entered: root.entered;
                Heading { title: "收藏项目"; description: root.width < 700px ? "" : "收藏并关注常用的 GitHub 项目，查看最新正式版本和下载附件。"; page: true; icon: @image-url("../resources/icons/Star-fill.svg"); }
            }
            HorizontalLayout { spacing: 18px; Input { text <=> Favorites.input; placeholder: "请输入 GitHub 仓库链接，例如 https://github.com/microsoft/PowerToys"; icon: @image-url("../resources/icons/Link-regular.svg"); enabled: !Favorites.busy; accepted => { Favorites.add(); } } ActionButton { text: "添加收藏"; icon: @image-url("../resources/icons/Plus-regular.svg"); primary: true; min-width: 100px; enabled: !Favorites.busy && Favorites.input != ""; clicked => { Favorites.add(); } } }
            if Favorites.message != "": Message { text: Favorites.message; }
        }
    }
    if Favorites.rule-repository != "": Panel {
        VerticalLayout {
            padding: 18px; spacing: 12px;
            Heading { title: "关注规则 · " + Favorites.rule-repository; description: "规则只影响自动检查与新版本发现；自动下载仍进入串行队列，不会自动开始。"; icon: @image-url("../resources/icons/GearSix-regular.svg"); }
            HorizontalLayout {
                spacing: 24px;
                VerticalLayout { spacing: 4px; Label { text: "包含预发布版本"; font-size: 12px; } Switch { checked <=> Favorites.rule-prerelease; } }
                VerticalLayout { spacing: 4px; Label { text: "发现新版后自动入队"; font-size: 12px; } Switch { checked <=> Favorites.rule-auto; } }
            }
            Input { text <=> Favorites.rule-pattern; placeholder: "附件名匹配，支持 * 与 ?，例如 *win*x64*.exe；留空则沿用全局规则"; }
            Muted { text: "规则变更立即生效；多命中或匹配不到时不会自动下载，可在收藏卡手动选择。"; font-size: 11px; wrap: word-wrap; }
            HorizontalLayout {
                spacing: 8px;
                ActionButton { text: "保存规则"; icon: @image-url("../resources/icons/CheckCircle-regular.svg"); primary: true; compact: true; clicked => { Favorites.save-rule(); } }
                ActionButton { text: "取消"; icon: @image-url("../resources/icons/X-regular.svg"); flat: true; compact: true; clicked => { Favorites.cancel-rule(); } }
            }
        }
    }
    Panel {
        border-width: 0px;
        VerticalLayout {
            padding: 0px; spacing: 12px;
            if root.width >= 700px: HorizontalLayout {
                spacing: 18px;
                Stat { title: "收藏项目（最多 200 个）"; value: Favorites.total; icon: @image-url("../resources/icons/Cube-regular.svg"); }
                Stat { title: "有更新"; value: Favorites.updates; tone: 3; icon: @image-url("../resources/icons/Star-fill.svg"); }
                Stat { title: "检查成功"; value: Favorites.successful; tone: 1; icon: @image-url("../resources/icons/CheckCircle-regular.svg"); }
                Stat { title: "检查异常"; value: Favorites.failed; tone: 2; icon: @image-url("../resources/icons/WarningCircle-regular.svg"); }
            }
            HorizontalLayout { spacing: 16px; ActionButton { text: Favorites.busy ? "正在检查…" : "检查全部"; icon: @image-url("../resources/icons/Play-fill.svg"); primary: true; min-width: 100px; enabled: !Favorites.busy && Favorites.total > 0; clicked => { Favorites.action("", "check"); } } if Favorites.checking: ActionButton { text: "取消检查"; icon: @image-url("../resources/icons/X-regular.svg"); compact: true; clicked => { Favorites.cancel-check(); } } Muted { text: "上次检查：" + Favorites.checked; } Rectangle { horizontal-stretch: 1; } if Favorites.auto-download: Badge { text: "自动下载已开启"; tone: 1; } }
            if Favorites.checking: VerticalLayout { spacing: 5px; Text { text: Favorites.checking-text; font-size: 11px; color: Theme.muted; } Rectangle { height: 5px; border-radius: 3px; background: Theme.border; Rectangle { width: parent.width * Favorites.checking-progress; height: parent.height; border-radius: 3px; background: Theme.accent; } } }
            if Workspace.api-warning: Message { text: Workspace.api-status; }
            if Workspace.unread-updates > 0: HorizontalLayout {
                spacing: 8px;
                Muted { text: Workspace.unread-updates + " 个项目有未读更新"; }
                ActionButton { text: "全部已读"; compact: true; flat: true; enabled: !Workspace.busy; clicked => { Workspace.dismiss-watch-updates(); } }
            }
        }
    }
    Panel {
        border-width: 0px;
        VerticalLayout {
            padding: 0px; spacing: 12px;
            HorizontalLayout {
                spacing: 8px;
                for label[index] in ["全部", "有更新", "检查成功", "检查失败", "待检查"]: ActionButton { text: label + " " + (index == 0 ? Favorites.total : index == 1 ? Favorites.updates : index == 2 ? Favorites.successful : index == 3 ? Favorites.failed : Favorites.pending); soft: Favorites.filter == index; compact: true; clicked => { Favorites.filter = index; Favorites.filter-changed(); } }
                Rectangle { horizontal-stretch: 1; }
                ComboBox { width: 105px; model: ["检查时间", "项目名称"]; current-index <=> Favorites.sort; selected => { Favorites.filter-changed(); } }
            }
            HorizontalLayout { alignment: end; spacing: 3px; ActionButton { text: "卡片"; icon: @image-url("../resources/icons/SquaresFour-regular.svg"); soft: !Favorites.list; compact: true; clicked => { Favorites.list = false; } } ActionButton { text: "列表"; icon: @image-url("../resources/icons/ListBullets-regular.svg"); soft: Favorites.list; compact: true; clicked => { Favorites.list = true; } } }
            if Favorites.rows.length == 0: EmptyState { title: Favorites.total > 0 ? "没有符合条件的收藏" : "还没有收藏项目"; description: Favorites.total > 0 ? "切换筛选条件查看其他项目。" : "从上方仓库链接或下载来源添加，常用项目触手可及。"; icon: @image-url("../resources/icons/Star-regular.svg"); }
            favorite-grid := BentoGrid {
                visible: Favorites.rows.length > 0;
                height: self.visible ? 560px : 0px;
                active: self.visible && !Favorites.list && Workspace.page == 2;
                content-x: favorite-list.content-x;
                content-y: favorite-list.content-y;
                favorite-list := ListView {
                    width: parent.width; height: parent.height;
                    property <int> columns: Favorites.list ? 1 : self.width > 1100px ? 3 : self.width > 740px ? 2 : 1;
                    for index in ceil(Favorites.rows.length / self.columns): bento-row := HorizontalLayout {
                        padding-bottom: Theme.card-gap; spacing: Theme.card-gap;
                        for column in favorite-list.columns: bento-column := VerticalLayout {
                            horizontal-stretch: 1;
                            if index * favorite-list.columns + column < Favorites.rows.length: FavoriteCard {
                                item: Favorites.rows[index * favorite-list.columns + column];
                                card-key: self.item.repository;
                                interactive: favorite-grid.active;
                                // 行列局部几何提供内容坐标，纵向滚动只由共享指示层叠加一次。
                                content-x: bento-row.x + bento-column.x + self.x;
                                content-y: bento-row.y + bento-column.y + self.y;
                                claim(key, rect, input, position) => { favorite-grid.claim(key, rect, input, position); }
                                update-card(key, rect) => { favorite-grid.update-card(key, rect); }
                                leave(key) => { favorite-grid.leave(key); }
                                forget(key) => { favorite-grid.forget(key); }
                            }
                        }
                    }
                }
            }
            Muted { text: "首次成功检查建立正式版基线，之后有新版本时生成提醒。自动检查可在设置中启用。"; font-size: 11px; wrap: word-wrap; }
        }
    }
}
