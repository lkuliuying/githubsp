export struct TaskRow {
    id: string, filename: string, state: string, tone: int, size: string,
    progress: float, percent: string, speed: string, eta: string, route: string,
    source-url: string, save-path: string, downloaded: string, elapsed: string,
    failure: string, feedback: string, suggestion: string, suggestion-id: string,
    resume: bool, pause: bool, cancel: bool, stopping: bool, completed: bool,
    removable: bool, queued: bool, first: bool, last: bool, queue-order: string,
    repository: string, preferred-route: int, route-editable: bool,
}
export struct RouteRow { id: string, name: string, speed: string, state: string, detail: string, tone: int }
export struct ReleaseRow { id: string, tag: string, detail: string }
export struct AssetRow { url: string, name: string, size: string, detail: string, unavailable: bool, selected: bool }
export struct PreviewRow { name: string, size: string, state: string, detail: string, task-id: string, tone: int }
export struct HistoryRow { id: string, number: string, name: string, state: string, repository: string, tag: string, date: string, completed: string, path: string, file-state: string, tone: int, removable: bool }
export struct FavoriteRow { repository: string, tag: string, state: string, tone: int, color-index: int, checked: string, error: string }
export struct NoteTableRow { cells: [string], header: bool }
export struct NoteBlock { content: styled-text, plain: string, kind: int, level: int, table: [NoteTableRow] }

export global Workspace {
    in-out property <int> page;
    in-out property <int> download-section;
    in-out property <int> creation-mode;
    in property <int> view-revision;
    in-out property <string> diagnostic-input;
    in-out property <bool> busy;
    in-out property <string> message;
    in-out property <string> queue-message;
    in-out property <string> url;
    in-out property <string> directory;
    in property <string> status;
    in property <string> total-tasks;
    in property <string> running-tasks;
    in property <string> queued-tasks;
    in property <string> recovering-tasks;
    in property <string> notices;
    in property <[TaskRow]> tasks;
    in property <[RouteRow]> routes;
    in property <string> route-target;
    in property <string> route-result;
    in property <string> route-best-name;
    in property <string> route-best-speed;
    in property <int> route-tone;
    in property <bool> diagnosing;
    in property <bool> can-pause;
    in property <bool> can-resume;
    in property <bool> can-clear;
    in-out property <string> expanded-task;
    callback navigate(int);
    callback select-download-section(int);
    callback select-creation-mode(int);
    callback select-settings-section(int);
    callback create();
    callback pick-directory();
    callback input-edited(bool);
    callback task-action(string, string);
    callback task-route(string, int);
    callback batch(string);
    callback diagnose();
    callback acknowledge();
    callback hide();
    callback about();
}

export global Sources {
    in-out property <string> repository;
    in-out property <string> batch-input;
