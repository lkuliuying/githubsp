    in property <bool> loaded;
    in property <int> page;
    in property <bool> has-more;
    in property <int> selected-count;
    in property <string> selected-size: "0 B";
    in property <bool> preview-visible;
    in property <int> preview-valid-count;
    in property <int> preview-duplicate-count;
    in property <int> preview-invalid-count;
    in property <string> preview-directory;
    in property <string> preview-known-size;
    in property <int> preview-unknown-count;
    in property <string> preview-available-space;
    in property <string> preview-space-note;
    in property <[PreviewRow]> preview;
    in property <bool> can-submit;
    in-out property <int> route;
    callback browse(int);
    callback select-release(string);
    callback select-asset(string, bool);
    callback edited();
    callback preview-batch(bool);
    callback submit();
    callback dismiss-preview();
    callback favorite();
}

export global History {
    in property <string> revision;
