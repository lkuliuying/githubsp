// 动效令牌：所有页面共用，避免各处写散落的时长和缓动。
export global Motion {
    // 用户设置在“设置 → 窗口与提醒”中，系统动画开关由 Rust 侧合并后写入。
    in-out property <bool> reduce: false;
    out property <duration> instant: reduce ? 0ms : 80ms;
    out property <duration> fast: reduce ? 0ms : 120ms;
    out property <duration> base: reduce ? 0ms : 180ms;
    out property <duration> slow: reduce ? 0ms : 260ms;
    out property <duration> emphasized: reduce ? 0ms : 360ms;
    // 交互反馈专用：悬停/按下要短于 base，点击才有“跟手”的感觉。
    out property <duration> hover: reduce ? 0ms : 140ms;
    out property <duration> press: reduce ? 0ms : 90ms;
    out property <duration> ripple: reduce ? 0ms : 300ms;
    out property <duration> magnetic: reduce ? 0ms : 260ms;
    out property <duration> magnetic-gap: reduce ? 0ms : 60ms;
    out property <duration> reveal: reduce ? 0ms : 180ms;
    out property <length> reveal-distance: reduce ? 0px : 6px;
    out property <length> card-lift: reduce ? 0px : 2px;
    out property <length> card-press: reduce ? 0px : 1px;
    out property <duration> navigation: reduce ? 0ms : 220ms;
    // 强调过渡：弹窗入场、行内操作显隐，介于 base 与 slow 之间。
    out property <duration> emphasis: reduce ? 0ms : 200ms;
    out property <length> page-distance: reduce ? 0px : 4px;
    out property <float> page-opacity: reduce ? 1 : 0.94;
}

// easing 仅供 Slint 使用，避免导出为 Rust 尚不支持的公共属性类型。
export global MotionCurves {
    out property <easing> magnetic: spring(0);
    out property <easing> feedback: cubic-bezier(0.2, 0, 0, 1);
    // 减速曲线：选中层、页面与开关落位，起步快、收尾轻。
    out property <easing> decelerate: cubic-bezier(0, 0, 0.2, 1);
}
