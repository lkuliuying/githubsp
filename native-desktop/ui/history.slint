import { ComboBox, ListView, ScrollView } from "std-widgets.slint";
import { Theme, Heading, Input, ActionButton, Label, Muted, Icon, Badge, EmptyState, Message, StatusDot } from "theme.slint";
import { History, HistoryRow, Workspace, Updates } from "state.slint";
import { DetailSelection, DetailField, SelectableRow } from "master-detail.slint";

component HistoryDetail inherits VerticalLayout {
    height: self.preferred-height;
    in property <HistoryRow> item;
    in property <bool> collapsible;
    callback collapse();
    spacing: 16px;
    HorizontalLayout {
        Label { text: "记录详情"; font-size: 18px; font-weight: 650; }
        if root.collapsible: ActionButton { text: "收起"; help: "收起历史详情"; compact: true; flat: true; clicked => { root.collapse(); } }
    }
    Label { text: root.item.name; font-size: 16px; font-weight: 600; wrap: char-wrap; }
    HorizontalLayout {
        alignment: start;
        Badge { text: root.item.file-state; tone: root.item.file-state == "文件缺失" ? 3 : root.item.tone; width: 110px; }
    }
    if root.item.file-state == "文件缺失": Label {
        text: root.item.state == "下载完成" ? "下载记录已完成，当前保存位置未找到文件。" : "当前保存位置未找到文件，下载状态请见下方。";
        font-size: 13px; wrap: word-wrap;
    }
    if root.item.file-state == "路径不可访问": Label { text: "当前保存位置无法访问，请检查路径或存储设备。"; font-size: 13px; wrap: word-wrap; }
    DetailField { title: "下载状态"; value: root.item.state; }
    HorizontalLayout {
        spacing: 8px; alignment: start;
        ActionButton { text: "重新下载"; icon: @image-url("../resources/icons/DownloadSimple-regular.svg"); compact: true; primary: true; enabled: !Updates.dialog && !Workspace.busy; clicked => { Workspace.task-action(root.item.id, "redownload"); } }
        ActionButton { text: "打开目录"; icon: @image-url("../resources/icons/FolderOpen-regular.svg"); compact: true; enabled: !Updates.dialog && !Workspace.busy; clicked => { Workspace.task-action(root.item.id, "open"); } }
    }
    Rectangle { height: 1px; background: Theme.border; }
    DetailField { title: "来源仓库"; value: root.item.repository; }
    DetailField { title: "版本"; value: root.item.tag; }
    DetailField { title: "添加时间"; value: root.item.date; }
    DetailField { title: "完成时间"; value: root.item.completed; }
    DetailField { title: "保存位置"; value: root.item.path; }
    ActionButton { text: "复制来源链接"; icon: @image-url("../resources/icons/Link-regular.svg"); compact: true; flat: true; enabled: !Updates.dialog && !Workspace.busy; clicked => { Workspace.task-action(root.item.id, "copy"); } }
    if root.item.removable: ActionButton { text: "移除记录，保留文件"; compact: true; danger: true; enabled: !Updates.dialog && !Workspace.busy; clicked => { Workspace.task-action(root.item.id, "remove"); } }
}

component HistoryRecord inherits Rectangle {
    in property <HistoryRow> item;
    in property <bool> compact;
    in property <bool> selected;
    in property <bool> inline-detail;
    callback choose();
    callback collapse();
    height: content.preferred-height;
    content := VerticalLayout {
        spacing: 0px;
        summary := SelectableRow {
            height: root.compact ? 108px : 100px;
            selected: root.selected; enabled: !Updates.dialog;
            description: "查看历史详情：" + root.item.name;
            choose => { root.choose(); }
            HorizontalLayout {
                padding: 14px; spacing: 12px;
                StatusDot { tone: root.item.state == "下载完成" ? 1 : root.item.state == "下载失败" ? 2 : 0; }
                VerticalLayout {
                    horizontal-stretch: 1; min-width: 0px; spacing: 6px; alignment: center;
                    Label { text: root.item.name; font-size: 14px; font-weight: 600; }
                    Muted { text: root.item.repository + " · " + root.item.tag; font-size: 12px; }
                    Muted { text: root.item.date + (root.compact ? " · " + root.item.file-state : ""); font-size: 12px; }
                }
                if !root.compact: VerticalLayout {
                    width: 114px; spacing: 8px; alignment: center;
                    Label { text: root.item.file-state; font-size: 12px; color: root.item.file-state == "文件缺失" ? Theme.warning-text : root.item.tone == 2 ? Theme.red : Theme.muted; }
                    Label { text: root.item.state; font-size: 12px; color: root.item.state == "下载完成" ? Theme.success-text : root.item.state == "下载失败" ? Theme.red : Theme.muted; }
                }
                ActionButton { icon: @image-url("../resources/icons/DotsThreeVertical-regular.svg"); help: "历史详情与更多操作"; flat: true; compact: true; enabled: !Updates.dialog; clicked => { root.choose(); } }
            }
        }
        if root.inline-detail && root.selected: HistoryDetail { item: root.item; padding: 20px; collapsible: true; collapse => { root.collapse(); } }
        Rectangle { height: 1px; background: Theme.border; }
    }
}

export component HistoryPage inherits Rectangle {
    min-width: 0px;
    background: white;
    border-radius: Theme.panel-radius;
    private property <bool> wide: self.width >= 760px;
    private property <length> list-width: root.wide && History.rows.length > 0 ? root.width - min(320px, root.width * 0.36) - 24px : root.width;
    private property <string> selected-key;
    private property <HistoryRow> selection: DetailSelection.history(History.rows, selected-key);
    private property <string> current-id: selection.id;
    private property <int> current-page: History.page;
    changed current-id => { history-scroll.content-y = 0px; }
    changed current-page => { root.selected-key = ""; records.content-y = 0px; }
    master := VerticalLayout {
        x: 0px; y: 0px; width: root.list-width; height: root.height; spacing: 12px;
        Heading { page: true; title: "下载历史"; description: "搜索过去的下载，重新下载或定位文件。"; }
        HorizontalLayout {
            spacing: 8px;
            Input { text <=> History.query; placeholder: "搜索文件名、仓库或版本"; icon: @image-url("../resources/icons/MagnifyingGlass-regular.svg"); enabled: !Updates.dialog && !History.busy; accepted => { History.load(1); } }
            ComboBox { width: root.width < 700px ? 112px : 144px; model: ["全部状态", "等待下载", "检测下载线路", "正在下载", "等待重试", "等待线路恢复", "正在完成下载", "正在保存进度", "正在取消", "已暂停", "下载完成", "下载失败", "已取消"]; current-index <=> History.filter; enabled: !Updates.dialog && !History.busy; }
            ActionButton { text: History.busy ? "读取中…" : "搜索 / 刷新"; compact: true; primary: true; enabled: !Updates.dialog && !History.busy; clicked => { History.load(1); } }
            ActionButton { text: "重置"; compact: true; enabled: !Updates.dialog && !History.busy; clicked => { History.reset(); } }
        }
        Muted { text: "共 " + History.total + " 条记录 · 本页完成 " + History.completed + (History.failed > 0 ? " · 下载失败 " + History.failed : "") + " · 文件异常 " + History.missing; font-size: 13px; height: 22px; }
        if History.message != "": Message { text: History.message; }
        history-area := Rectangle {
            vertical-stretch: 1; min-height: 120px;
            if History.rows.length == 0: EmptyState { title: "没有匹配的下载记录"; description: "调整搜索关键词或状态筛选后重试。"; icon: @image-url("../resources/icons/ClockCounterClockwise-regular.svg"); }
            records := ListView {
                visible: History.rows.length > 0;
                width: parent.width;
                height: parent.height;
                for row in History.rows: HistoryRecord {
                    x: 0px; width: records.visible-width;
                    item: row; compact: records.width < 620px;
                    selected: root.selection.id == row.id && (root.wide || root.selected-key != "");
                    inline-detail: !root.wide;
                    choose => { root.selected-key = row.id; }
                    collapse => { root.selected-key = ""; }
                }
            }
        }
        HorizontalLayout {
            spacing: 6px;
            Muted { text: "第 " + History.page + " / " + History.pages + " 页 · 每页 20 条"; font-size: 12px; }
            ActionButton { text: "上一页"; compact: true; enabled: !Updates.dialog && !History.busy && History.page > 1; clicked => { History.load(History.page - 1); } }
            if master.width >= 760px: HorizontalLayout {
                spacing: 4px;
                for index in min(5, History.pages): ActionButton { property <int> number: max(1, min(History.page - 2, History.pages - 4)) + index; text: self.number; soft: self.number == History.page; compact: true; enabled: !Updates.dialog && !History.busy; clicked => { History.load(self.number); } }
            }
            ActionButton { text: "下一页"; compact: true; enabled: !Updates.dialog && !History.busy && History.page < History.pages; clicked => { History.load(History.page + 1); } }
            Input { text <=> History.jump; placeholder: "页码"; width: 50px; enabled: !Updates.dialog && !History.busy; accepted => { History.jump-to(); } }
            ActionButton { text: "跳转"; compact: true; enabled: !Updates.dialog && !History.busy; clicked => { History.jump-to(); } }
        }
        Muted { text: "按添加时间倒序 · 移除记录不会删除已下载文件。文件状态按当前保存位置检查。"; font-size: 11px; height: 18px; }
    }
    Rectangle { visible: root.wide && History.rows.length > 0; x: root.list-width + 12px; width: 1px; height: root.height; background: Theme.border; }
    history-scroll := ScrollView {
        visible: root.wide && History.rows.length > 0;
        x: root.list-width + 24px; width: max(0px, root.width - self.x); height: root.height;
        content-width: self.visible-width;
        HistoryDetail { x: 0px; y: 0px; width: history-scroll.visible-width; item: root.selection; padding-right: 8px; padding-bottom: 16px; }
    }
}
