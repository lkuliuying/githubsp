import { ComboBox, ListView } from "std-widgets.slint";
import { Theme, Panel, Heading, Input, ActionButton, Label, Muted, Stat, Badge, EmptyState, Message } from "theme.slint";
import { History, HistoryRow, Workspace } from "state.slint";

component HistoryRecord inherits Rectangle {
    in property <HistoryRow> item;
    in property <bool> compact;
    private property <bool> expanded;
    height: content.preferred-height;
    content := VerticalLayout {
        spacing: 8px; padding-top: 10px; padding-bottom: 10px;
        HorizontalLayout {
            spacing: 10px;
            Muted { text: root.item.number; width: 28px; }
            VerticalLayout {
                horizontal-stretch: 1; min-width: 100px; spacing: 4px;
                Label { text: root.item.name; font-weight: 600; }
                Muted { text: root.item.repository + " · " + root.item.tag; font-size: 11px; }
            }
            if !root.compact: VerticalLayout {
                width: 142px; spacing: 4px;
                Label { text: root.item.date; font-size: 11px; }
                Muted { text: root.item.state; font-size: 11px; }
            }
            Badge { text: root.item.file-state; tone: root.item.tone; width: 94px; }
            HorizontalLayout {
                spacing: 2px;
                ActionButton { icon: @image-url("../resources/icons/FolderOpen-regular.svg"); help: "打开目录"; flat: true; compact: true; enabled: !Workspace.busy; clicked => { Workspace.task-action(root.item.id, "open"); } }
                ActionButton { icon: @image-url("../resources/icons/DownloadSimple-regular.svg"); help: "重新下载"; flat: true; compact: true; enabled: !Workspace.busy; clicked => { Workspace.task-action(root.item.id, "redownload"); } }
                ActionButton { icon: @image-url("../resources/icons/DotsThreeVertical-regular.svg"); help: "历史详情与更多操作"; flat: true; compact: true; clicked => { root.expanded = !root.expanded; } }
            }
        }
        if root.compact: Muted { text: root.item.state + " · " + root.item.date; font-size: 11px; }
        if root.expanded: VerticalLayout {
            padding: 12px; spacing: 8px;
            Label { text: "完整文件名：" + root.item.name; wrap: word-wrap; }
            Label { text: "保存位置：" + root.item.path; wrap: word-wrap; }
            Muted { text: "完成时间：" + root.item.completed; wrap: word-wrap; }
            HorizontalLayout {
                spacing: 8px; alignment: start;
                ActionButton { text: "复制来源链接"; compact: true; enabled: !Workspace.busy; clicked => { Workspace.task-action(root.item.id, "copy"); } }
                if root.item.removable: ActionButton { text: "移除记录，保留文件"; compact: true; danger: true; enabled: !Workspace.busy; clicked => { Workspace.task-action(root.item.id, "remove"); } }
            }
        }
        Rectangle { height: 1px; background: Theme.border; }
    }
}

export component HistoryPage inherits VerticalLayout {
    min-width: 0px;
    spacing: 14px;
    Heading { page: true; title: "下载历史"; description: "搜索过去的下载，重新下载或定位文件。"; }
    HorizontalLayout {
        spacing: 8px;
        Input { text <=> History.query; placeholder: "搜索文件名、仓库或版本"; icon: @image-url("../resources/icons/MagnifyingGlass-regular.svg"); enabled: !History.busy; accepted => { History.load(1); } }
        ComboBox { width: root.width < 700px ? 124px : 160px; model: ["全部状态", "等待下载", "检测下载线路", "正在下载", "等待重试", "等待线路恢复", "正在完成下载", "正在保存进度", "正在取消", "已暂停", "下载完成", "下载失败", "已取消"]; current-index <=> History.filter; enabled: !History.busy; }
        ActionButton { text: History.busy ? "读取中…" : "搜索 / 刷新"; compact: true; primary: true; enabled: !History.busy; clicked => { History.load(1); } }
        ActionButton { text: "重置"; compact: true; enabled: !History.busy; clicked => { History.reset(); } }
    }
    HorizontalLayout {
        spacing: 8px;
        Stat { title: "匹配记录"; value: History.total; compact: true; }
        Stat { title: "本页已完成"; value: History.completed; compact: true; tone: 1; }
        Stat { title: "本页下载失败"; value: History.failed; compact: true; tone: 2; }
        Stat { title: "本页文件异常"; value: History.missing; compact: true; tone: 3; }
    }
    if History.message != "": Message { text: History.message; }
    Muted { text: "共 " + History.total + " 条记录 · 按添加时间倒序"; height: 20px; }
    if History.rows.length == 0: EmptyState { title: "没有匹配的下载记录"; description: "调整搜索关键词或状态筛选后重试。"; icon: @image-url("../resources/icons/ClockCounterClockwise-regular.svg"); }
    if History.rows.length > 0: records := ListView {
        height: 390px;
        for row in History.rows: HistoryRecord { item: row; compact: records.width < 760px; }
    }
    HorizontalLayout {
        spacing: 6px;
        Muted { text: "第 " + History.page + " / " + History.pages + " 页 · 每页 20 条"; }
        ActionButton { text: "上一页"; compact: true; enabled: !History.busy && History.page > 1; clicked => { History.load(History.page - 1); } }
        if root.width >= 760px: HorizontalLayout {
            spacing: 4px;
            for index in min(5, History.pages): ActionButton { property <int> number: max(1, min(History.page - 2, History.pages - 4)) + index; text: self.number; soft: self.number == History.page; compact: true; enabled: !History.busy; clicked => { History.load(self.number); } }
        }
        ActionButton { text: "下一页"; compact: true; enabled: !History.busy && History.page < History.pages; clicked => { History.load(History.page + 1); } }
        Input { text <=> History.jump; placeholder: "页码"; width: 50px; enabled: !History.busy; accepted => { History.jump-to(); } }
        ActionButton { text: "跳转"; compact: true; enabled: !History.busy; clicked => { History.jump-to(); } }
    }
    Muted { text: "移除记录不会删除已下载文件。文件状态按当前保存位置检查。"; font-size: 11px; wrap: word-wrap; }
}
