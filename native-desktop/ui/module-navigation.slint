import { Workspace, Updates } from "state.slint";
import { Theme, Label, Muted, Icon, ActionButton } from "theme.slint";

export component WorkspaceNavigation inherits Rectangle {
    min-width: 0px;
    in property <bool> compact;
    background: Theme.canvas;
    Rectangle { x: parent.width - 1px; width: 1px; background: Theme.border; }
    VerticalLayout {
        padding: root.compact ? 8px : 12px; spacing: 8px;
        HorizontalLayout {
            height: 56px; padding-left: root.compact ? 6px : 8px; spacing: 10px;
            Icon { source: @image-url("../resources/icons/CloudArrowDown-fill.svg"); tint: Theme.green; width: 28px; preferred-height: 28px; }
            if !root.compact: Label { text: "GitHubSP"; font-size: 18px; font-weight: 700; }
        }
        for item[index] in [
            { label: "下载", icon: @image-url("../resources/icons/DownloadSimple-regular.svg") },
            { label: "历史", icon: @image-url("../resources/icons/ClockCounterClockwise-regular.svg") },
            { label: "收藏", icon: @image-url("../resources/icons/Star-regular.svg") }
        ]: VerticalLayout {
            spacing: 4px;
            Rectangle {
                height: 40px;
                ActionButton {
                    text: root.compact ? "" : item.label; help: item.label;
                    icon: item.icon; icon-size: 20px; leading: !root.compact;
                    font-size: 14px; weight: Workspace.page == index ? 650 : 400;
                    flat: true; soft: Workspace.page == index; icon-motion: false;
                    accent-text: Workspace.page == index ? Theme.green-hover : Theme.text;
                    enabled: !Updates.dialog;
                    clicked => { Workspace.navigate(index); }
                }
                if index == 2 && Workspace.unread-updates > 0: Rectangle {
                    x: parent.width - (root.compact ? 12px : 30px); y: root.compact ? 2px : 10px;
                    width: root.compact ? 8px : 24px; height: root.compact ? 8px : 20px;
                    border-radius: 10px; background: Theme.green;
                    if !root.compact: Text { text: Workspace.unread-updates > 99 ? "99+" : Workspace.unread-updates; color: white; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; }
                }
            }
            if index == 0 && Workspace.page == 0 && !root.compact: VerticalLayout {
                spacing: 4px;
                for label[section] in ["下载队列", "新建下载", "线路检测"]: Rectangle {
                    height: 36px;
                    ActionButton {
                        text: label; font-size: 13px; leading: true; flat: true;
                        soft: Workspace.download-section == section;
                        accent-text: Workspace.download-section == section ? Theme.green-hover : Theme.muted;
                        enabled: !Updates.dialog;
                        clicked => { Workspace.select-download-section(section); }
                    }
                    if Workspace.download-section == section: Rectangle { x: 0px; y: 8px; height: 20px; width: 2px; border-radius: 1px; background: Theme.green; }
                }
            }
        }
        Rectangle { vertical-stretch: 1; }
        ActionButton {
            text: root.compact ? "" : "设置"; help: "设置";
            icon: @image-url("../resources/icons/GearSix-regular.svg"); icon-size: 20px;
            font-size: 14px; leading: !root.compact; flat: true; soft: Workspace.page == 3;
            icon-motion: false; enabled: !Updates.dialog;
            clicked => { Workspace.navigate(3); }
        }
        if !root.compact: Muted { text: "v0.3.0"; height: 24px; font-size: 11px; }
    }
}

// 模块入口按剩余宽度等分；长文案换行，最小窗口也不隐藏模块。
export component ModuleNavigation inherits Rectangle {
    min-width: 0px;
    in property <string> title;
    in property <[string]> items;
    in property <[image]> icons;
    in property <int> selected;
    callback select(int);
    height: root.width < 660px ? 52px : 42px;
    Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border; }
    HorizontalLayout {
        spacing: 2px;
        for item[index] in root.items: Rectangle {
            horizontal-stretch: 1;
            ActionButton {
                text: ""; help: item; flat: true;
                enabled: !Updates.dialog;
                clicked => { root.select(index); }
            }
            Text {
                x: 4px; y: 4px; width: parent.width - 8px; height: parent.height - 8px;
                text: item; font-size: root.width < 660px ? 11px : 13px;
                font-weight: root.selected == index ? 650 : 400;
                color: root.selected == index ? Theme.green-hover : Theme.muted;
                horizontal-alignment: center; vertical-alignment: center; wrap: word-wrap;
            }
            if root.selected == index: Rectangle { x: 8px; y: parent.height - 2px; width: parent.width - 16px; height: 2px; background: Theme.green; }
        }
    }
}
