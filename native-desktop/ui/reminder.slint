import { ListView } from "std-widgets.slint";
import { Theme, Label, Muted, ActionButton, Icon, EmptyState } from "theme.slint";
import { Reminder, UpdateNoticeRow } from "state.slint";
import { Motion, MotionCurves } from "motion.slint";

component BadgeLabel inherits Rectangle {
    in property <string> text;
    min-width: 46px; height: 20px; border-radius: 6px; background: Theme.accent-soft;
    Text { text: parent.text; color: Theme.accent-text; font-size: 10px; font-weight: 650; horizontal-alignment: center; vertical-alignment: center; }
}

export component ReminderWindow inherits Window {
    title: "GitHubSP · 收藏更新";
    width: 430px;
    height: 360px;
    no-frame: true;
    always-on-top: true;
    background: transparent;
    default-font-family: "Segoe UI";
    default-font-size: 13px;
    in-out property <bool> entered: false;
    Rectangle {
        width: parent.width - 16px; height: parent.height - 16px; x: 8px;
        y: root.entered ? 8px : 8px + Motion.reveal-distance;
        opacity: root.entered || Motion.reduce ? 1 : Motion.page-opacity;
        animate y { duration: Motion.emphasis; easing: MotionCurves.decelerate; }
        animate opacity { duration: Motion.base; easing: ease-out; }
        border-radius: Theme.panel-radius; background: white; border-width: 1px; border-color: Theme.border;
        drop-shadow-blur: 22px; drop-shadow-color: Theme.shadow-strong; drop-shadow-offset-y: 6px;
        VerticalLayout {
            spacing: 0px;
            Rectangle {
                height: 54px; background: Theme.surface-muted; border-radius: Theme.panel-radius;
                HorizontalLayout {
                    padding-left: 16px; padding-right: 10px; spacing: 10px;
                    Icon { source: @image-url("../resources/icons/Star-fill.svg"); width: 22px; tint: Theme.accent; }
                    VerticalLayout { spacing: 2px; Label { text: "收藏项目有新版本"; font-size: 15px; font-weight: 650; } Muted { text: Reminder.unread + " 项待查看 · 点击查看或下载"; font-size: 11px; } }
                    Rectangle { horizontal-stretch: 1; }
                    ActionButton { icon: @image-url("../resources/icons/X-regular.svg"); help: "稍后查看"; flat: true; compact: true; clicked => { Reminder.dismiss(); } }
                }
            }
            if Reminder.items.length == 0: EmptyState { title: "暂无新版本"; description: "保持应用运行，发现更新后会在这里提醒。"; icon: @image-url("../resources/icons/Star-regular.svg"); }
            if Reminder.items.length > 0: ListView {
                for item in Reminder.items: Rectangle {
                    height: 86px;
                    Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border; }
                    VerticalLayout {
                        padding: 12px; spacing: 5px;
                        HorizontalLayout { spacing: 8px; Label { text: item.repository; font-weight: 650; } BadgeLabel { text: item.tag; } if item.published != "": Muted { text: item.published; font-size: 10px; horizontal-stretch: 0; } Rectangle { horizontal-stretch: 1; } }
                        if item.summary != "": Muted { text: item.summary; font-size: 11px; wrap: word-wrap; max-height: 24px; }
                        HorizontalLayout { spacing: 7px; ActionButton { text: "查看"; compact: true; soft: true; clicked => { Reminder.open(); } } ActionButton { text: "下载最新版"; compact: true; primary: true; clicked => { Reminder.download(item.repository); } } Rectangle { horizontal-stretch: 1; } ActionButton { text: "忽略"; compact: true; flat: true; clicked => { Reminder.ignore(item.repository, item.release-id); } } }
                    }
                }
            }
            if Reminder.unread > 0: HorizontalLayout {
                padding: 10px; spacing: 8px;
                ActionButton { text: "全部忽略"; compact: true; flat: true; clicked => { Reminder.ignore-all(); } }
                Rectangle { horizontal-stretch: 1; }
                ActionButton { text: "打开收藏页"; compact: true; primary: true; clicked => { Reminder.open(); } }
            }
        }
    }
}
