import { ScrollView } from "std-widgets.slint";
import { Theme, Label, Muted, Icon, ActionButton, Message } from "theme.slint";
import { WorkspaceNavigation } from "module-navigation.slint";
import { Motion } from "motion.slint";
import { Workspace, Preferences, Updates, Storage } from "state.slint";
import { DownloadsPage } from "downloads.slint";
import { HistoryPage } from "history.slint";
import { FavoritesPage } from "favorites.slint";
import { SettingsPage, UpdateDialog, MigrationDialog } from "settings.slint";
import "../resources/NotoSansSC-Regular.otf";
export { CompletionWindow, AboutWindow } from "windows.slint";
export { ReminderWindow } from "reminder.slint";
export { Motion } from "motion.slint";
export { Workspace, Sources, History, Favorites, Preferences, Storage, Updates, Reminder, TaskRow, RouteRow, ReleaseRow, AssetRow, PreviewRow, HistoryRow, FavoriteRow, UpdateNoticeRow, NoteBlock, NoteTableRow } from "state.slint";

export component MainWindow inherits Window {
    title: "GitHubSP · 下载加速";
    icon: @image-url("../resources/tray.png");
    preferred-width: 1040px;
    preferred-height: 740px;
    min-width: 720px;
    min-height: 520px;
    max-width: 100000px;
    max-height: 100000px;
    background: white;
    default-font-family: "Segoe UI";
    default-font-size: 13px;
    in-out property <bool> busy <=> Workspace.busy;
    in-out property <string> message <=> Workspace.message;
    in-out property <string> directory <=> Workspace.directory;
    private property <bool> show-notices;
    in-out property <bool> page-entering: true;
    private property <int> current-page: Workspace.page;
    private property <bool> compact-navigation: root.width < 900px;
    changed current-page => { main-scroll.content-y = 0px; }
    callback hide-to-tray();
    callback exit();
    callback refresh-state();
    callback show-main();
    callback about();
    Rectangle {
        min-width: 0px; max-width: 100000px;
        min-height: 0px; max-height: 100000px;
        WorkspaceNavigation { x: 0px; y: 0px; width: root.compact-navigation ? 64px : 192px; height: parent.height; compact: root.compact-navigation; }
        VerticalLayout {
            x: root.compact-navigation ? 64px : 192px;
            width: parent.width - self.x; height: parent.height;
            spacing: 0px;
            Rectangle {
                height: 52px;
                Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border; }
                HorizontalLayout {
                    padding-left: 20px; padding-right: 16px; spacing: 12px;
                    Icon { source: @image-url("../resources/icons/FolderOpen-regular.svg"); width: 16px; preferred-height: 16px; }
                    Muted {
                        text: Workspace.page == 0 ? "下载 / " + (Workspace.download-section == 0 ? "下载队列" : Workspace.download-section == 1 ? "新建下载" : "线路检测") : Workspace.page == 1 ? "历史 / 下载记录" : Workspace.page == 2 ? "收藏 / 项目更新" : "设置 / 应用偏好";
                        font-size: 12px;
                    }
                    if Workspace.unread-updates > 0: ActionButton { text: root.compact-navigation ? "更新 " + Workspace.unread-updates : Workspace.unread-updates + " 个项目有更新"; help: "查看收藏更新"; compact: true; flat: true; icon: @image-url("../resources/icons/Star-regular.svg"); enabled: !Updates.dialog; clicked => { Workspace.navigate(2); } }
                    ActionButton { text: root.compact-navigation ? "" : "收起到托盘"; help: "收起到托盘"; icon: @image-url("../resources/icons/Tray-regular.svg"); flat: true; compact: true; enabled: !Updates.dialog; clicked => { root.hide-to-tray(); } }
                }
            }
            VerticalLayout {
                padding: root.compact-navigation ? 16px : 20px; spacing: 10px;
                if Workspace.message != "": HorizontalLayout {
                    spacing: 8px;
                    error-scroll := ScrollView {
                        horizontal-stretch: 1; height: min(error-message.min-height, 76px);
                        content-width: self.visible-width;
                        error-message := Message { width: error-scroll.visible-width; height: self.min-height; text: Workspace.message; error: true; }
                    }
                    ActionButton { enabled: !Updates.dialog; icon: @image-url("../resources/icons/X-regular.svg"); help: "关闭错误提示"; flat: true; compact: true; clicked => { Workspace.message = ""; } }
                }
                if Workspace.notices != "": VerticalLayout {
                    spacing: 8px;
                    HorizontalLayout {
                        spacing: 10px;
                        ActionButton { enabled: !Updates.dialog; text: root.show-notices ? "收起应用提醒" : "查看应用提醒"; soft: true; compact: true; clicked => { root.show-notices = !root.show-notices; } }
                        Rectangle { horizontal-stretch: 1; }
                        ActionButton { text: "全部已读"; compact: true; enabled: !Updates.dialog && !Workspace.busy; clicked => { Workspace.acknowledge(); } }
                    }
                    if root.show-notices: ScrollView { height: 72px; content-width: self.visible-width; Message { text: Workspace.notices; success: true; } }
                }
                Rectangle {
                    vertical-stretch: 1; min-height: 120px; clip: true;
                    page-body := Rectangle {
                        x: Workspace.page == 2 || root.page-entering ? 0px : 8px;
                        width: parent.width; height: parent.height;
                        animate x { enabled: Workspace.page != 2; duration: Motion.base; easing: cubic-bezier(0.2, 0, 0, 1); }
                        opacity: Workspace.page == 2 || root.page-entering ? 1 : 0;
                        animate opacity { enabled: Workspace.page != 2; duration: Motion.base; easing: ease-out; }
                        if Workspace.page == 0: DownloadsPage { width: parent.width; height: parent.height; show-navigation: root.compact-navigation; }
                        if Workspace.page == 3: SettingsPage { width: parent.width; height: parent.height; }
                        main-scroll := ScrollView {
                            visible: Workspace.page == 1 || Workspace.page == 2;
                            enabled: self.visible && !Updates.dialog;
                            width: parent.width; height: parent.height; content-width: self.visible-width;
                            VerticalLayout {
                                min-width: 0px;
                                padding-right: 8px;
                                if Workspace.page == 1: HistoryPage {}
                                if Workspace.page == 2: FavoritesPage { entered: root.page-entering; }
                            }
                        }
                    }
                }
            }
        }
    }
    if Updates.dialog: UpdateDialog {}
    if Storage.dialog || Storage.migrating: MigrationDialog {}
}
