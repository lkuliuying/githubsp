{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GitHubSP",
  "version": "0.2.3",
  "identifier": "com.githubsp.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "label": "main",
      "title": "GitHubSP · 下载加速",
      "width": 1040,
      "height": 740,
      "minWidth": 720,
      "minHeight": 520,
      "backgroundColor": "#F7F8F5"
    }],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": { "active": false, "icon": ["icons/icon.ico", "icons/32x32.png", "icons/128x128.png"] }
}
